<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.back.price.mapper.DailyPriceMapper">

    <!-- "date", "change", "changeRate" 는 Oracle 예약어/대소문자 때문에 따옴표로 만든 컬럼이라 SQL 에서도 따옴표를 붙인다 -->
    <resultMap id="dailyPriceMap" type="com.kh.back.price.entity.DailyPrice">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="tradeDate" column="trade_date"/>
        <result property="open" column="open"/>
        <result property="high" column="high"/>
        <result property="low" column="low"/>
        <result property="close" column="close"/>
        <result property="volume" column="volume"/>
        <result property="change" column="price_change"/>
        <result property="changeRate" column="change_rate"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="columns">
        p.id, p.code, p."date" AS trade_date, p.open, p.high, p.low, p.close, p.volume,
        p."change" AS price_change, p."changeRate" AS change_rate, p.updated_at
    </sql>

    <select id="findLatestOfEachCode" resultMap="dailyPriceMap">
        SELECT <include refid="columns"/>
        FROM daily_price p
        WHERE p."date" = (SELECT MAX(p2."date") FROM daily_price p2 WHERE p2.code = p.code)
        ORDER BY p.code
    </select>

    <select id="findByCodeAndTradeDateBetweenOrderByTradeDateAsc" resultMap="dailyPriceMap">
        SELECT <include refid="columns"/>
        FROM daily_price p
        WHERE p.code = #{code}
          AND p."date" BETWEEN #{from} AND #{to}
        ORDER BY p."date" ASC
    </select>

    <select id="existsByCode" resultType="boolean">
        SELECT CASE WHEN EXISTS (SELECT 1 FROM daily_price WHERE code = #{code}) THEN 1 ELSE 0 END
        FROM dual
    </select>
</mapper>
